{
  "extends": "./pyright.shared.json",
  "include": [
    "."
  ],
  "exclude": [
    "**/migrations",
    "**/__pycache__",
    "**/node_modules",
    ".venv",
    "build",
    "dist",
    // Generated by turms. ruff checks it like the rest, but the KuvertApi mixin
    // calls execute/aexecute/subscribe/asubscribe of the class it is mixed into
    // (Kuvert), which a type checker cannot see from the mixin alone.
    "kuvert/api/schema.py"
  ]
}
